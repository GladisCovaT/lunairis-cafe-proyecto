{
  "name": "lunairis-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma web de Lunairis Café: café, creatividad, tecnología y bienestar emocional.",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "setup:front": "npm --prefix frontend install",
    "dev:front": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^9.12.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "protobufjs@7.6.6": true
  }
}
